#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

python3 - <<'PY'
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


def git_output(*arguments: str) -> bytes:
    result = subprocess.run(
        ["git", *arguments, "-z", "--", "*.md"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        sys.stderr.buffer.write(result.stderr)
        raise SystemExit(result.returncode)
    return result.stdout


def decode_records(output: bytes) -> list[str]:
    return [
        value.decode("utf-8", errors="strict")
        for value in output.split(b"\0")
        if value
    ]


def staged_entries() -> list[tuple[str, str]]:
    records = decode_records(
        git_output("diff", "--cached", "--name-status", "--no-renames")
    )
    if len(records) % 2:
        print("malformed staged Markdown inventory", file=sys.stderr)
        raise SystemExit(1)
    entries = list(zip(records[::2], records[1::2]))
    if any(status not in {"A", "D", "M", "T"} for status, _ in entries):
        print("unsupported staged Markdown status", file=sys.stderr)
        raise SystemExit(1)
    return entries


entries = staged_entries()
lint_paths: list[str] = []
full_repository_lint = False
if entries:
    unstaged = set(decode_records(git_output("diff", "--name-only")))
    overlap = sorted(
        path
        for status, path in entries
        if path in unstaged or (status == "D" and os.path.lexists(path))
    )
    if overlap:
        print(
            "staged/worktree Markdown mismatch: "
            + ", ".join(json.dumps(path, ensure_ascii=False) for path in overlap),
            file=sys.stderr,
        )
        raise SystemExit(1)

    lint_paths = [
        path
        for status, path in entries
        if status != "D"
    ]
    if any(status == "D" for status, _ in entries):
        lint_paths = []
        full_repository_lint = True

git_directory = subprocess.run(
    ["git", "rev-parse", "--path-format=absolute", "--git-dir"],
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    check=False,
)
if git_directory.returncode:
    sys.stderr.buffer.write(git_directory.stderr)
    raise SystemExit(git_directory.returncode)
git_dir = git_directory.stdout.removesuffix(b"\n").decode("utf-8", errors="strict")
if not os.path.isabs(git_dir) or not os.path.isdir(git_dir):
    print("invalid Git directory", file=sys.stderr)
    raise SystemExit(1)

with tempfile.TemporaryDirectory(prefix="cs-study-pre-commit-") as directory:
    snapshot = Path(directory)
    checkout = subprocess.run(
        [
            "git",
            "checkout-index",
            "--all",
            "--force",
            f"--prefix={snapshot}{os.sep}",
        ],
        stderr=subprocess.PIPE,
        check=False,
    )
    if checkout.returncode:
        sys.stderr.buffer.write(checkout.stderr)
        raise SystemExit(checkout.returncode)

    requirements = snapshot / "requirements-lint.txt"
    uv_python = ["uv", "run", "--with-requirements", str(requirements), "python"]
    snapshot_env = os.environ.copy()
    snapshot_env["GIT_DIR"] = git_dir
    snapshot_env["GIT_WORK_TREE"] = str(snapshot)
    if lint_paths or full_repository_lint:
        safe_paths = [f"./{path}" if path.startswith("-") else path for path in lint_paths]
        lint_arguments = ["--repository-paths", *safe_paths] if lint_paths else []
        lint = subprocess.run(
            [
                *uv_python,
                "scripts/lint.py",
                "--report",
                "jsonl",
                *lint_arguments,
            ],
            cwd=snapshot,
            env=snapshot_env,
            check=False,
        )
        if lint.returncode:
            raise SystemExit(lint.returncode)

    tests = subprocess.run(
        [
            *uv_python,
            "-m",
            "pytest",
            "-q",
            "tests/test_contract.py",
            "tests/test_project_boundaries.py",
        ],
        cwd=snapshot,
        env=snapshot_env,
        check=False,
    )
    raise SystemExit(tests.returncode)
PY
