{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Information Security Practice Question Pack",
  "type": "object",
  "required": ["version", "packId", "questions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "packId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "curriculumId", "stage", "title", "prompt", "answer", "explanation", "sourceRefs", "tags", "prerequisites"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "curriculumId": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "$ref": "#/$defs/blockArray" },
          "examPrompt": { "$ref": "#/$defs/blockArray" },
          "questionKind": { "enum": ["predicted"] },
          "answer": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["short", "cloze", "order", "essay"] },
              "matchPolicy": { "enum": ["case-insensitive", "exact"] },
              "inputLabel": { "type": "string", "minLength": 1 },
              "accepted": { "$ref": "#/$defs/nonEmptyStringArray" },
              "blanks": { "type": "array", "minItems": 1 },
              "items": { "type": "array", "minItems": 1 },
              "expected": { "type": "array", "minItems": 1 },
              "modelAnswer": { "$ref": "#/$defs/nonEmptyStringArray" },
              "keywordGroups": { "type": "array", "minItems": 1 },
              "deductionRisks": { "$ref": "#/$defs/nonEmptyStringArray" }
            }
          },
          "explanation": { "$ref": "#/$defs/blockArray" },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "line", "status", "excerpt"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["official", "source-derived", "inferred"] },
                "excerpt": { "type": "string", "minLength": 3 }
              }
            }
          },
          "tags": { "$ref": "#/$defs/nonEmptyStringArray" },
          "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "blockArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": { "enum": ["text", "code"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
