{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Information Security Practice Question Pack",
  "type": "object",
  "required": ["version", "packId", "questions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "packId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "curriculumId", "stage", "title", "prompt", "answer", "explanation", "sourceRefs", "tags", "prerequisites"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "curriculumId": { "type": "string" },
          "stage": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "array", "minItems": 1 },
          "examPrompt": { "type": "array", "minItems": 1 },
          "questionKind": { "enum": ["predicted"] },
          "answer": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "matchPolicy": { "enum": ["case-insensitive", "exact"] },
              "keywordGroups": { "type": "array" }
            }
          },
          "explanation": { "type": "array", "minItems": 1 },
          "sourceRefs": { "type": "array", "minItems": 1 },
          "tags": { "type": "array", "minItems": 1 },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
