{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs-study:knowledge-migration-resolution:1.0",
  "title": "Approved Knowledge Migration Preservation Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "knowledge_root",
    "base_tree_sha256",
    "capture_created_at",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "preservation"},
    "knowledge_root": {"const": "wiki"},
    "base_tree_sha256": {"$ref": "#/$defs/digest"},
    "capture_created_at": {"type": "string", "format": "date-time"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativeMarkdown": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.md$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "target_path",
        "source_sha256",
        "page_type",
        "members"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/relativeMarkdown"},
        "target_path": {"$ref": "#/$defs/relativeMarkdown"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "page_type": {"type": "string", "minLength": 1},
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"page_type": {"const": "collection"}}, "required": ["page_type"]},
          "then": {"properties": {"members": {"minItems": 52, "maxItems": 52}}},
          "else": {"properties": {"members": {"maxItems": 0}}}
        }
      ]
    }
  }
}
