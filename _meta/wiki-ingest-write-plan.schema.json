{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-study.local/_meta/wiki-ingest-write-plan.schema.json",
  "title": "Wiki Ingest Semantic WritePlan",
  "description": "Semantic input for raw video -> wiki source summary. This schema is not a file-write plan; Python validator renders paths, frontmatter, markdown, roll-up fields, and write operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "raw_path",
    "video_id",
    "domain_decision",
    "source_summary",
    "claims",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "wiki-ingest-plan.v1"
    },
    "raw_path": {
      "type": "string",
      "pattern": "^raw/sources/video/[A-Za-z0-9_-]+\\.md$"
    },
    "video_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "domain_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "confidence", "rationale", "source"],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["classifier", "write_plan", "override"]
        }
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "main_claims"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "main_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primary", "claim", "status", "evidence", "notes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "primary": {
            "type": "boolean"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["claimed", "corroborated", "verified", "rejected"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "slug", "label", "status", "matched_path", "reason"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["concept", "entity"]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["existing", "review-needed", "duplicate"]
          },
          "matched_path": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
