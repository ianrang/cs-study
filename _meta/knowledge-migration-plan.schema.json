{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs-study:knowledge-migration-plan:1.0",
  "title": "Resolved Knowledge Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "resolution_mode",
    "knowledge_root",
    "repository_head",
    "inventory_plan_sha256",
    "base_tree_sha256",
    "expected_target_tree_sha256",
    "source_canonical_universe",
    "target_canonical_universe",
    "unresolved_decisions",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "resolved"},
    "resolution_mode": {"enum": ["generic", "preservation"]},
    "knowledge_root": {"const": "wiki"},
    "repository_head": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "inventory_plan_sha256": {"$ref": "#/$defs/digest"},
    "base_tree_sha256": {"$ref": "#/$defs/digest"},
    "expected_target_tree_sha256": {"$ref": "#/$defs/digest"},
    "source_canonical_universe": {"$ref": "#/$defs/pathList"},
    "target_canonical_universe": {"$ref": "#/$defs/pathList"},
    "unresolved_decisions": {"type": "array", "maxItems": 0},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativeMarkdown": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.md$"
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativeMarkdown"}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "target_path",
        "source_sha256",
        "target_sha256",
        "target_mode",
        "content_base64"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/relativeMarkdown"},
        "target_path": {"$ref": "#/$defs/relativeMarkdown"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "target_sha256": {"$ref": "#/$defs/digest"},
        "target_mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "content_base64": {"type": "string", "minLength": 1}
      }
    }
  }
}
